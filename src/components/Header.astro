---
import HeaderLink from './HeaderLink.astro';
---

<header class="retro-panel overflow-hidden">
	<div class="grid gap-4 bg-[#d7e5f2] px-4 py-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
		<div class="space-y-3">
			<a href="/" class="inline-block no-underline hover:text-ocean-950">
				<h1 class="retro-heading text-3xl sm:text-4xl">kamplom.me</h1>
			</a>
			<p class="max-w-3xl border-l-2 border-ocean-900 pl-3 font-mono text-sm text-ocean-900">
				Generally, matters that concern or amuse me.
			</p>
		</div>
		<div class="space-y-3 lg:text-right">
			<nav class="flex flex-wrap gap-3 lg:justify-end">
				<HeaderLink
					href="/"
					class="border border-[#001f5c] bg-[#efefef] px-3 py-2 font-mono text-sm font-bold uppercase text-ocean-950 no-underline hover:bg-white active:bg-[#ffffcc]"
				>
					Home
				</HeaderLink>
				<HeaderLink
					href="/blog"
					class="border border-[#001f5c] bg-[#efefef] px-3 py-2 font-mono text-sm font-bold uppercase text-ocean-950 no-underline hover:bg-white active:bg-[#ffffcc]"
				>
					Blog
				</HeaderLink>
				<HeaderLink
					href="/about"
					class="border border-[#001f5c] bg-[#efefef] px-3 py-2 font-mono text-sm font-bold uppercase text-ocean-950 no-underline hover:bg-white active:bg-[#ffffcc]"
				>
					About
				</HeaderLink>
				<HeaderLink
					href="/projects"
					class="border border-[#001f5c] bg-[#efefef] px-3 py-2 font-mono text-sm font-bold uppercase text-ocean-950 no-underline hover:bg-white active:bg-[#ffffcc]"
				>
					Projects
				</HeaderLink>
			</nav>
			<p class="font-mono text-xs text-ocean-900/70 lg:text-right">
				<span id="visitor-count">visitor #000000</span> · rss.xml online
			</p>
		</div>
	</div>
</header>

<script is:inline>
	(async () => {
		try {
			const res = await fetch('https://countapi.mileshilliard.com/api/v1/hit/kamplom-blog-visits');
			if (!res.ok) return;
			const data = await res.json();
			const count = Number(data?.value ?? 0);
			if (!Number.isFinite(count)) return;

			const el = document.getElementById('visitor-count');
			if (!el) return;
			el.textContent = `visitor #${String(count).padStart(6, '0')}`;
		} catch {
			// keep fallback text
		}
	})();
</script>
