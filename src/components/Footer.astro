---
const today = new Date();
---

<footer class="retro-panel mt-8 overflow-hidden">
	<div class="grid gap-3 px-4 py-4 sm:grid-cols-[1fr_auto] sm:items-center">
		<div>
			<p class="m-0 font-display text-base font-black uppercase tracking-[0.08em] text-ocean-950">
				kamplom
			</p>
			<p class="m-0 mt-2 max-w-2xl font-mono text-sm text-ocean-900">
				© {today.getFullYear()} personal notes and links.
			</p>
		</div>
		<p class="m-0 font-mono text-xs text-ocean-900/70 sm:text-right">
			<a href="https://github.com/kamplom">github.com/kamplom</a>
		</p>
	</div>
</footer>
